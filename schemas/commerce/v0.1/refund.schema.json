{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dagr-commerce.dev/schema/v0.1/refund.schema.json",
  "title": "Refund v0.1",
  "description": "A protocol-neutral projection of a refund or cancellation event. A refund references the original order and payment authorization by reference; it never rewrites or replaces the original authorization object. Relative $ref values resolve against this $id.",
  "type": "object",
  "required": ["object_type", "contract_version", "refund_id", "refund_state"],
  "properties": {
    "object_type": { "const": "refund" },
    "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "refund_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "order_ref": { "$ref": "common.schema.json#/$defs/subject_reference" },
    "original_payment_ref": {
      "description": "Reference to the original payment authorization/settlement. Referenced, never mutated.",
      "$ref": "common.schema.json#/$defs/subject_reference"
    },
    "amount": { "$ref": "common.schema.json#/$defs/non_negative_monetary_amount" },
    "refund_state": {
      "type": "string",
      "enum": ["requested", "refunded_observed", "denied_observed", "uncertain"]
    },
    "reason": { "type": "string", "maxLength": 1024 },
    "native": { "$ref": "common.schema.json#/$defs/protocol_native_reference" },
    "observations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/check_observation" }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}

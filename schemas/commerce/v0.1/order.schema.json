{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dagr-commerce.dev/schema/v0.1/order.schema.json",
  "title": "Order v0.1",
  "description": "A protocol-neutral projection of an order record. Order state is an operational observation including an explicit uncertain state. Relative $ref values resolve against this $id.",
  "type": "object",
  "required": ["object_type", "contract_version", "order_id", "order_state"],
  "properties": {
    "object_type": { "const": "order" },
    "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "order_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "merchant_ref": { "$ref": "common.schema.json#/$defs/subject_reference" },
    "cart_ref": { "$ref": "common.schema.json#/$defs/subject_reference" },
    "order_state": {
      "type": "string",
      "enum": ["created", "updated", "fulfilled_observed", "cancelled_observed", "uncertain"]
    },
    "amount": { "$ref": "common.schema.json#/$defs/non_negative_monetary_amount" },
    "native": { "$ref": "common.schema.json#/$defs/protocol_native_reference" },
    "observations": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/check_observation" }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcs.dev/ecosystem/ecosystem.exceptions.v0.1.schema.json",
  "title": "ARCS Ecosystem Exception Declarations v0.1",
  "description": "Declares conformance or release exceptions with scope, reason, owner, approval, status, dates, affected conformance level, mitigation, and disposition.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "repository",
    "exceptions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://schemas.arcs.dev/ecosystem/ecosystem.exceptions.v0.1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "conformance_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "exception": {
      "type": "object",
      "required": [
        "id",
        "scope",
        "reason",
        "owner",
        "approved_by",
        "status",
        "created_date",
        "affected_conformance_level",
        "mitigation",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "scope": {
          "type": "object",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "repository",
                "capability",
                "contract",
                "dependency",
                "lane",
                "release",
                "conformance_gate"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "expired",
            "closed",
            "rejected"
          ]
        },
        "created_date": {
          "$ref": "#/$defs/date"
        },
        "review_date": {
          "$ref": "#/$defs/date"
        },
        "expiration_date": {
          "$ref": "#/$defs/date"
        },
        "affected_conformance_level": {
          "$ref": "#/$defs/conformance_level"
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "temporary",
            "permanent",
            "accepted_risk",
            "rejected",
            "closed"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "disposition": {
                "const": "temporary"
              }
            },
            "required": [
              "status",
              "disposition"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "review_date"
                ]
              },
              {
                "required": [
                  "expiration_date"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}

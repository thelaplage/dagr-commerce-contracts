{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcs.dev/ecosystem/ecosystem.architecture-passport.v0.1.schema.json",
  "title": "ARCS Ecosystem Architecture Passport v0.1",
  "description": "Describes a repository as an implementation container within the constitutional layer model, including authority references, cross-layer imports, prohibited dependencies, owners, migration status, non-goals, conformance posture, and exceptions.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "repository",
    "repository_type",
    "constitutional_layers",
    "owning_layer",
    "mission",
    "owned_concerns",
    "imported_concerns",
    "exported_contracts",
    "authority_references",
    "allowed_cross_layer_imports",
    "prohibited_dependencies",
    "extension_points",
    "current_owners",
    "candidate_owners",
    "migration",
    "security_boundary",
    "non_goals",
    "conformance",
    "known_exceptions"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://schemas.arcs.dev/ecosystem/ecosystem.architecture-passport.v0.1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "repository_type": {
      "$ref": "#/$defs/repository_type"
    },
    "authority_status": {
      "$ref": "#/$defs/repository_authority_status"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/lifecycle_state"
    },
    "substrate_surface_role": {
      "$ref": "#/$defs/substrate_surface_role"
    },
    "owning_layer": {
      "$ref": "#/$defs/owning_layer",
      "description": "Legacy descriptive layer label retained separately from constitutional layer IDs."
    },
    "constitutional_layers": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/layer_id"
        },
        "secondary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layer_id"
          }
        }
      },
      "additionalProperties": false
    },
    "secondary_implementation_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/implementation_role_ref"
      }
    },
    "mission": {
      "type": "string",
      "minLength": 20
    },
    "owned_concerns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concern"
      }
    },
    "owned_concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concern"
      }
    },
    "imported_concerns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imported_concern"
      }
    },
    "imported_concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imported_concern"
      }
    },
    "exported_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract_reference"
      }
    },
    "authority_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_cross_layer_imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cross_layer_import"
      }
    },
    "prohibited_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prohibited_dependency"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency_reference"
      }
    },
    "extension_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension_point"
      }
    },
    "compatibility_guarantees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibility_guarantee"
      }
    },
    "current_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/owner_ref"
      }
    },
    "candidate_owners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_owner_ref"
      }
    },
    "migration": {
      "$ref": "#/$defs/migration_state"
    },
    "surface_binding": {
      "$ref": "#/$defs/surface_binding"
    },
    "security_boundary": {
      "type": "object",
      "required": [
        "summary",
        "trusted_inputs",
        "protected_assets",
        "non_authoritative_for"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "trusted_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_authoritative_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conformance": {
      "type": "object",
      "required": [
        "declared_level",
        "status"
      ],
      "properties": {
        "declared_level": {
          "$ref": "#/$defs/conformance_level"
        },
        "status": {
          "$ref": "#/$defs/conformance_status"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "known_exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "assertion_status": {
      "type": "string",
      "enum": [
        "declared",
        "planned",
        "partial",
        "implemented",
        "fixture_reachable",
        "recorded_end_to_end",
        "validated",
        "independently_verified",
        "ratified",
        "canonical",
        "not_evaluated",
        "not_applicable",
        "deprecated_reference"
      ]
    },
    "candidate_owner_ref": {
      "type": "object",
      "required": [
        "repository",
        "candidate_verified",
        "migration_authorized"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "candidate_verified": {
          "type": "boolean"
        },
        "migration_authorized": {
          "type": "boolean"
        },
        "migration_record_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "compatibility_guarantee": {
      "type": "object",
      "required": [
        "scope",
        "claim_status",
        "description"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "$ref": "#/$defs/assertion_status"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "concern": {
      "type": "object",
      "required": [
        "id",
        "description",
        "claim_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "$ref": "#/$defs/assertion_status"
        }
      },
      "additionalProperties": false
    },
    "conformance_level": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "conformance_status": {
      "type": "string",
      "enum": [
        "planned",
        "partial",
        "validated",
        "independently_verified",
        "blocked",
        "not_applicable",
        "not_evaluated"
      ]
    },
    "contract_reference": {
      "type": "object",
      "required": [
        "contract_id",
        "version",
        "owning_layer",
        "semantic_authority",
        "claim_status"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "owning_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "semantic_authority": {
          "$ref": "#/$defs/semantic_authority_ref"
        },
        "claim_status": {
          "$ref": "#/$defs/assertion_status"
        }
      },
      "additionalProperties": false
    },
    "cross_layer_import": {
      "type": "object",
      "required": [
        "from_layer",
        "to_layer",
        "reason"
      ],
      "properties": {
        "from_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "to_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dependency_reference": {
      "type": "object",
      "required": [
        "repository",
        "reason"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "extension_point": {
      "type": "object",
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/assertion_status"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "implementation_role": {
      "type": "string",
      "enum": [
        "semantic_authority",
        "current_implementation",
        "candidate_implementation",
        "historical_implementation",
        "consumer",
        "producer",
        "emitter",
        "provider",
        "adapter",
        "runtime_binding",
        "verifier_counterpart",
        "operational_owner",
        "schema_coordination",
        "planned_role",
        "not_applicable"
      ]
    },
    "implementation_role_ref": {
      "type": "object",
      "required": [
        "layer",
        "role"
      ],
      "properties": {
        "layer": {
          "$ref": "#/$defs/layer_id"
        },
        "role": {
          "$ref": "#/$defs/implementation_role"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "imported_concern": {
      "type": "object",
      "required": [
        "id",
        "constitutional_layer",
        "semantic_authority",
        "relationship",
        "claim_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "constitutional_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "semantic_authority": {
          "$ref": "#/$defs/semantic_authority_ref"
        },
        "relationship": {
          "$ref": "#/$defs/relationship"
        },
        "claim_status": {
          "$ref": "#/$defs/assertion_status"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "layer_id": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9",
        "L10",
        "L11"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "proposed",
        "doctrine_ready",
        "reference",
        "proof_pack",
        "preview",
        "stable",
        "maintenance",
        "superseded",
        "archived"
      ]
    },
    "migration_state": {
      "type": "object",
      "required": [
        "authorized",
        "record_ref"
      ],
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "record_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "owner_ref": {
      "type": "object",
      "required": [
        "repository",
        "role"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/$defs/implementation_role"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "owning_layer": {
      "type": "string",
      "enum": [
        "doctrine",
        "schema_coordination",
        "model",
        "runtime",
        "runtime_binding",
        "adapter",
        "verifier",
        "viewer",
        "proof_pack",
        "policy_pack",
        "product",
        "reference",
        "operations"
      ]
    },
    "prohibited_dependency": {
      "type": "object",
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "prohibited"
        },
        "source_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "target_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "string",
      "enum": [
        "consumes",
        "implements",
        "emits",
        "validates",
        "projects",
        "renders",
        "operates",
        "planned",
        "partial",
        "not_applicable",
        "deprecated_reference",
        "references",
        "does_not_own"
      ]
    },
    "repository_authority_status": {
      "type": "string",
      "enum": [
        "doctrine_authority",
        "semantic_authority",
        "distributed_authority",
        "unresolved_authority",
        "implementation_support",
        "current_implementation",
        "candidate_implementation",
        "historical_implementation",
        "consumer",
        "producer",
        "verifier_counterpart",
        "operational_owner",
        "archived_noncanonical"
      ]
    },
    "repository_type": {
      "type": "string",
      "enum": [
        "doctrine",
        "standard",
        "schema",
        "model",
        "runtime",
        "runtime_binding",
        "adapter",
        "verifier",
        "viewer",
        "proof_pack",
        "policy_pack",
        "product",
        "reference_app",
        "reference_repository",
        "tooling",
        "schema_source",
        "validator",
        "index_generator",
        "lane_initializer"
      ]
    },
    "semantic_authority_ref": {
      "type": "object",
      "required": [
        "repository",
        "status"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "unresolved",
            "distributed",
            "historical",
            "ratified",
            "canonical"
          ]
        }
      },
      "additionalProperties": false
    },
    "substrate_surface_role": {
      "type": "string",
      "enum": [
        "substrate",
        "surface",
        "coordination",
        "not_applicable"
      ]
    },
    "surface_binding": {
      "type": "object",
      "required": [
        "projects_over",
        "authors",
        "resolves",
        "canon_index_ref"
      ],
      "properties": {
        "projects_over": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authors": {
          "type": "string",
          "const": "none"
        },
        "resolves": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "canon_index_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "string",
      "pattern": "^(v)?\\d+\\.\\d+(\\.\\d+)?([_-][A-Za-z0-9][A-Za-z0-9._-]*)?$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcs.dev/ecosystem/ecosystem.lanes.v0.1.schema.json",
  "title": "ARCS Ecosystem Lane Declarations v0.1",
  "description": "Declares active and historical coordination lanes, including touched repositories, capabilities, contracts, artifacts, upstream work, overlap keys, blockers, downstream blocks, milestones, and completion gates.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "repository",
    "lanes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://schemas.arcs.dev/ecosystem/ecosystem.lanes.v0.1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "path_or_ref",
        "claim_status"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "schema",
            "fixture",
            "document",
            "proof_pack",
            "test",
            "release_note",
            "external_reference"
          ]
        },
        "path_or_ref": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "$ref": "#/$defs/claim_status"
        }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "mitigated",
            "closed",
            "deferred"
          ]
        }
      },
      "additionalProperties": false
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "declared",
        "planned",
        "partial",
        "implemented",
        "fixture_reachable",
        "recorded_end_to_end",
        "validated",
        "independently_verified",
        "ratified",
        "canonical",
        "not_evaluated",
        "not_applicable",
        "deprecated_reference"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "gate": {
      "type": "object",
      "required": [
        "gate_id",
        "description",
        "status"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "not_applicable"
          ]
        }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": [
        "lane_id",
        "status",
        "owner",
        "start_date",
        "objective",
        "repositories_touched",
        "capabilities_touched",
        "contracts_touched",
        "produced_artifacts",
        "consumed_upstream_work",
        "overlap_keys",
        "blockers",
        "downstream_blocks",
        "expected_completion_milestone",
        "completion_gates"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
        },
        "status": {
          "$ref": "#/$defs/lane_status"
        },
        "owner": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "contact": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "start_date": {
          "$ref": "#/$defs/date"
        },
        "objective": {
          "type": "string",
          "minLength": 20
        },
        "repositories_touched": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities_touched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts_touched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "produced_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "consumed_upstream_work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/upstream_work"
          }
        },
        "overlap_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "downstream_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "expected_completion_milestone": {
          "type": "string",
          "minLength": 1
        },
        "completion_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lane_status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "blocked",
        "review",
        "complete",
        "superseded",
        "abandoned"
      ]
    },
    "upstream_work": {
      "type": "object",
      "required": [
        "work_id",
        "semantic_authority",
        "claim_status"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_authority": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "$ref": "#/$defs/claim_status"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

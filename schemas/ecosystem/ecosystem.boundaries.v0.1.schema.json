{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arcs.dev/ecosystem/ecosystem.boundaries.v0.1.schema.json",
  "title": "ARCS Ecosystem Boundaries v0.1",
  "description": "Declares repository authority, import, security, and forbidden-dependency boundaries without implementing a scanner or redefining external semantics.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "repository",
    "boundaries",
    "forbidden_dependencies"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://schemas.arcs.dev/ecosystem/ecosystem.boundaries.v0.1.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "forbidden_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbidden_dependency"
      }
    },
    "native_registry_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/native_registry_ref"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "assertion_status": {
      "type": "string",
      "enum": [
        "declared",
        "planned",
        "partial",
        "implemented",
        "fixture_reachable",
        "recorded_end_to_end",
        "validated",
        "independently_verified",
        "ratified",
        "canonical",
        "not_evaluated",
        "not_applicable",
        "deprecated_reference"
      ]
    },
    "boundary": {
      "type": "object",
      "required": [
        "id",
        "boundary_type",
        "constitutional_layer",
        "owner_repository",
        "description",
        "assertion_status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "boundary_type": {
          "$ref": "#/$defs/boundary_type"
        },
        "constitutional_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "owner_repository": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "allowed_imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_rule"
          }
        },
        "prohibited_imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/import_rule"
          }
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertion_status": {
          "$ref": "#/$defs/assertion_status"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "boundary_type": {
      "type": "string",
      "enum": [
        "semantic_authority",
        "runtime_import",
        "verifier_isolation",
        "product_adapter",
        "policy",
        "evidence_presentation",
        "operations",
        "schema_ownership",
        "data",
        "security"
      ]
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "id",
        "path",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "$ref": "#/$defs/relationship"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "forbidden_dependency": {
      "type": "object",
      "required": [
        "id",
        "description",
        "source",
        "target",
        "status",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/dependency_endpoint"
        },
        "target": {
          "$ref": "#/$defs/dependency_endpoint"
        },
        "status": {
          "type": "string",
          "const": "prohibited"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "dependency_endpoint": {
      "type": "object",
      "required": [
        "repository",
        "constitutional_layer"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "constitutional_layer": {
          "$ref": "#/$defs/layer_id"
        },
        "concern": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "import_rule": {
      "type": "object",
      "required": [
        "repository",
        "relationship",
        "reason"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "$ref": "#/$defs/relationship"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "layer_id": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9",
        "L10",
        "L11"
      ]
    },
    "native_registry_ref": {
      "type": "object",
      "required": [
        "id",
        "path",
        "authority",
        "summary_role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "summary_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "string",
      "enum": [
        "consumes",
        "implements",
        "emits",
        "validates",
        "projects",
        "renders",
        "operates",
        "planned",
        "partial",
        "not_applicable",
        "deprecated_reference"
      ]
    }
  }
}
